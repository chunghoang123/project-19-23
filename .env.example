# =============================================================================
#  .env.example - copy thành .env rồi điền giá trị thật
#  Không commit file .env lên Git
# =============================================================================
COMPOSE_PROJECT_NAME=cinex
APP_IMAGE=cinex-app
APP_TAG=latest
APP_VERSION=1.0.0
APP_PORT=8090

# ----- MySQL -----
MYSQL_DATABASE=cinex
MYSQL_USER=cinex
MYSQL_PASSWORD=doi_mat_khau_manh
MYSQL_ROOT_PASSWORD=doi_mat_khau_root_khac

# ----- Ứng dụng -----
APP_NAME=CineX
APP_SEED_ENABLED=true
APP_SEED_ADMIN_EMAIL=admin@cinex.vn
APP_SEED_ADMIN_PASSWORD=admin123
APP_SHOWTIME_DAYS_AHEAD=7

# =============================================================================
#  TÍCH HỢP BÊN NGOÀI - khung hiện tại chưa dùng, điền khoá khi cần triển khai
# =============================================================================
# Đồng bộ phim từ TMDB
TMDB_API_KEY=
TMDB_API_URL=https://api.themoviedb.org/3

# Tìm trailer phim trên YouTube
YOUTUBE_API_KEY=

# Thanh toán online PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Trợ lý AI hội thoại (NVIDIA)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Đăng nhập bằng Google
GOOGLE_CLIENT_ID=

# Firebase (push notification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
